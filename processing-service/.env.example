# Copy to .env for local development. Never commit real credentials.
AZURE_SPEECH_ENDPOINT=replace-with-speech-resource-endpoint
AZURE_SPEECH_KEY=replace-with-speech-resource-key
AZURE_SPEECH_LANGUAGE=replace-with-language-tag
WELL_ACTUALLY_AUDIO_DEVICE=hw:CARD=M0,DEV=0
WELL_ACTUALLY_LED_SOCKET=unoq-led-indicator/well-actually-led.sock

# Use the Tiger Data PostgreSQL connection URI. Require TLS in the URI.
TIMESCALEDB_URL=postgresql://user:password@host:port/database?sslmode=require

# Pavlok stimulus API. Requests are disabled when the token is not set.
WAKE_WORD_API_URL=https://api.pavlok.com/api/v5/stimulus/send
WAKE_WORD_API_TOKEN=replace-with-pavlok-api-token
