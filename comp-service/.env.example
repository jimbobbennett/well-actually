# Paste your TigerDB connection string here.
DATABASE_URL=postgresql://reader:replace-me@replace-me.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
OPENAI_BASE_URL=https://your-openai-compatible-host.example/v1
OPENAI_MODEL=your-model-name
OPENAI_API_KEY=replace-me
# Required for loading the managed prompt from Arize Prompt Hub.
ARIZE_API_KEY=replace-me
ARIZE_PROMPT_ID_ORIGINAL=your-original-prompt-id
ARIZE_PROMPT_ID_SENSITIVE=your-sensitive-prompt-id
# Select original or sensitive, then restart the worker.
ARIZE_PROMPT_MODE=sensitive
# Leave empty for staging in testing mode, production otherwise.
ARIZE_PROMPT_LABEL=
ACTIVATION_LOG_PATH=logs/pavlok.jsonl
# Any speaker can be classified; the configured Pavlok device receives the selected stimulus.
WEARER_OPTED_IN=true
# Exact Authorization header value from Pavlok's API-key documentation/account.
PAVLOK_AUTHORIZATION=
PAVLOK_STIMULUS_TYPE=beep
PAVLOK_VIBRATION_STRENGTH=20
TRIGGER_CONFIDENCE=0.85
COOLDOWN_SECONDS=120
POLL_SECONDS=5
MAX_CONTEXT_ROWS=200
# true: read speech_log_test anchored to its newest row; false: read live speech_log.
TESTING_MODE=false
LOOKBACK_SECONDS=120
